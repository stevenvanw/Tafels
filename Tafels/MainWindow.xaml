<Window x:Class="Tafels.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Tafels"
        mc:Ignorable="d" 
        Title="Tafels" Height="700" Width="850"
        Background="#F4F7F6" MinWidth="800" MinHeight="600"
        Icon="Afbeeldingen/Icoon.ico">

    <Window.Resources>
        <Style TargetType="Label">
            <Setter Property="FontFamily" Value="Segoe UI Semibold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="#333333"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="FontFamily" Value="Segoe UI Bold"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Padding" Value="15,8"/>
            <Setter Property="Background" Value="#4A90E2"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Border" Background="{TemplateBinding Background}" CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <!-- Trigger voor wanneer de knop is uitgeschakeld -->
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Border" Property="Background" Value="#DCDCDC"/>
                                <Setter Property="Foreground" Value="#888888"/>
                                <Setter Property="Opacity" Value="0.6"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- Stijl voor een kleinere, subtielere knop (zoals voor de About-knop) -->
        <Style x:Key="SubtleButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="Background" Value="#4A90E2"/>
        </Style>
        <!-- Stijl voor een moderne, kindvriendelijke TextBox (zoals die van de Tijd) -->
        <Style x:Key="ModernTextBox" TargetType="TextBox">
            <Setter Property="FontFamily" Value="Segoe UI Semibold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#CCCCCC"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="border" 
                        Background="{TemplateBinding Background}" 
                        BorderBrush="{TemplateBinding BorderBrush}" 
                        BorderThickness="{TemplateBinding BorderThickness}" 
                        CornerRadius="8">
                            <ScrollViewer x:Name="PART_ContentHost" Focusable="false" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="true">
                                <Setter TargetName="border" Property="BorderBrush" Value="#A0C4FF"/>
                            </Trigger>
                            <Trigger Property="IsFocused" Value="true">
                                <Setter TargetName="border" Property="BorderBrush" Value="#4A90E2"/>
                                <Setter TargetName="border" Property="BorderThickness" Value="2"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- Stijl voor een strakke, moderne ComboBox -->
        <Style TargetType="ComboBox">
            <Setter Property="FontFamily" Value="Segoe UI Semibold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#CCCCCC"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="ToggleButton" 
                                  BorderBrush="{TemplateBinding BorderBrush}" 
                                  BorderThickness="{TemplateBinding BorderThickness}" 
                                  Background="{TemplateBinding Background}" 
                                  Grid.Column="2" 
                                  Focusable="false"
                                  IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="Border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8">
                                            <Path x:Name="Arrow" Fill="#4A90E2" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0" Data="M 0 0 L 4 4 L 8 0 Z"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="true">
                                                <Setter TargetName="Border" Property="BorderBrush" Value="#A0C4FF"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter x:Name="ContentSite" IsHitTestVisible="False" Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}" Margin="10,3,30,3" VerticalAlignment="Center" HorizontalAlignment="Left"/>
                            <Popup x:Name="Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}" AllowsTransparency="True" Focusable="False" PopupAnimation="Slide">
                                <Grid x:Name="DropDown" SnapsToDevicePixels="True" MinWidth="{TemplateBinding ActualWidth}" MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                    <Border x:Name="DropDownBorder" Background="White" BorderBrush="#4A90E2" BorderThickness="1.5" CornerRadius="8" Margin="0,2,0,0">
                                        <Border.Effect>
                                            <DropShadowEffect BlurRadius="5" Color="#DDDDDD" Direction="270" ShadowDepth="2"/>
                                        </Border.Effect>
                                        <ScrollViewer Margin="4" SnapsToDevicePixels="True">
                                            <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained"/>
                                        </ScrollViewer>
                                    </Border>
                                </Grid>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <!-- Hoofdindeling van het venster -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <!-- Bovenste deel voor jouw huidige content -->
            <RowDefinition Height="Auto"/>
            <!-- Onderste balk voor versie en About -->
        </Grid.RowDefinitions>

        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 1. BOVENBALK: INSTELLINGEN & SCORE -->
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="White" CornerRadius="12" Padding="12,8" Margin="0,0,15,0">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="10" Color="#DDDDDD" Direction="270" ShadowDepth="2"/>
                        </Border.Effect>
                        <StackPanel>
                            <Label Content="Kies de tafels:" FontWeight="Bold" Padding="0,0,0,5"/>
                            <UniformGrid Columns="3" MaxWidth="280">
                                <CheckBox x:Name="cbox2" Content="2" Margin="5" Checked="CheckBox_Checked" Unchecked="CheckBox_UnChecked"/>
                                <CheckBox x:Name="cbox3" Content="3" Margin="5" Checked="CheckBox_Checked" Unchecked="CheckBox_UnChecked"/>
                                <CheckBox x:Name="cbox4" Content="4" Margin="5" Checked="CheckBox_Checked" Unchecked="CheckBox_UnChecked"/>
                                <CheckBox x:Name="cbox5" Content="5" Margin="5" Checked="CheckBox_Checked" Unchecked="CheckBox_UnChecked"/>
                                <CheckBox x:Name="cbox6" Content="6" Margin="5" Checked="CheckBox_Checked" Unchecked="CheckBox_UnChecked"/>
                                <CheckBox x:Name="cbox7" Content="7" Margin="5" Checked="CheckBox_Checked" Unchecked="CheckBox_UnChecked"/>
                                <CheckBox x:Name="cbox8" Content="8" Margin="5" Checked="CheckBox_Checked" Unchecked="CheckBox_UnChecked"/>
                                <CheckBox x:Name="cbox9" Content="9" Margin="5" Checked="CheckBox_Checked" Unchecked="CheckBox_UnChecked"/>
                                <CheckBox x:Name="cbox10" Content="10" Margin="5" Checked="CheckBox_Checked" Unchecked="CheckBox_UnChecked"/>
                            </UniformGrid>
                        </StackPanel>
                    </Border>

                    <StackPanel VerticalAlignment="Center" Margin="5,0,0,0">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <Label Content="Oefeningen:" Width="90" VerticalAlignment="Center"/>
                            <ComboBox x:Name="cboxAantalOefeningen" Width="80" Height="28" SelectionChanged="cboxAantalOefeningen_SelectionChanged">
                                <ComboBoxItem Content="5"/>
                                <ComboBoxItem Content="10"/>
                                <ComboBoxItem Content="15"/>
                                <ComboBoxItem Content="20"/>
                            </ComboBox>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Label Content="Bewerking:" Width="90" VerticalAlignment="Center"/>
                            <ComboBox x:Name="cboxBewerking" Width="80" Height="28" SelectionChanged="cboxBewerking_SelectionChanged">
                                <ComboBoxItem Content=" x "/>
                                <ComboBoxItem Content=" : "/>
                                <ComboBoxItem Content=" x en : "/>
                            </ComboBox>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="#E6F4EA" CornerRadius="12" Padding="15,10" Margin="0,0,10,0" MinWidth="80">
                        <StackPanel HorizontalAlignment="Center">
                            <Label Content="Goed 👍" Foreground="#137333" HorizontalAlignment="Center" FontWeight="Bold"/>
                            <TextBox x:Name="tboxAantalGoed" Text="0" FontSize="22" FontWeight="Bold" Foreground="#137333" Background="Transparent" BorderThickness="0" IsReadOnly="True" HorizontalContentAlignment="Center"/>
                        </StackPanel>
                    </Border>
                    <Border Background="#FCE8E6" CornerRadius="12" Padding="15,10" MinWidth="80">
                        <StackPanel HorizontalAlignment="Center">
                            <Label Content="Fout 👎" Foreground="#C5221F" HorizontalAlignment="Center" FontWeight="Bold"/>
                            <TextBox x:Name="tboxAantalFout" Text="0" FontSize="22" FontWeight="Bold" Foreground="#C5221F" Background="Transparent" BorderThickness="0" IsReadOnly="True" HorizontalContentAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
            <!-- 2. MIDDEN: DE OEFENING -->
            <Grid Grid.Row="1" Margin="0,20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,15">
                    <Button x:Name="btnStart" Content="▶ Start" Background="#2ECC71" Margin="0,0,10,0" Width="100" Click="ButtonStart_Click"/>
                    <Button x:Name="btnStop" Content="■ Stop" Background="#E74C3C" Width="100" Click="ButtonStop_Click"/>
                </StackPanel>

                <Border Grid.Row="1" Background="White" CornerRadius="20" Padding="30" MaxWidth="500" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="15" Color="#CCCCCC" Direction="270" ShadowDepth="3"/>
                    </Border.Effect>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Label x:Name="lblRandomMaal" Content=".." FontSize="48" FontWeight="Bold" VerticalAlignment="Center"/>
                        <Label x:Name="lblOperator" Content="x" FontSize="48" FontWeight="Bold" Foreground="#4A90E2" Margin="10,0" VerticalAlignment="Center"/>
                        <Label x:Name="lblTafelMaal" Content=".." FontSize="48" FontWeight="Bold" VerticalAlignment="Center"/>
                        <Label Content="=" FontSize="48" FontWeight="Bold" Margin="15,0" VerticalAlignment="Center"/>
                        <TextBox x:Name="tboxUitkomst" Text=".." FontSize="44" FontWeight="Bold" Width="90" Height="70" 
                             HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                             Background="#F4F7F6" BorderBrush="#4A90E2" BorderThickness="3" KeyDown="tboxUitkomst_KeyDown" TextChanged="tboxUitkomst_TextChanged" Style="{StaticResource ModernTextBox}"/>
                    </StackPanel>
                </Border>

                <Grid Grid.Row="2" MaxWidth="600" Margin="0,15,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Label Grid.Column="0" Content="Tijd:" VerticalAlignment="Center" FontWeight="Bold"/>
                    <ProgressBar x:Name="pbarTijd" Grid.Column="1" Height="20" Margin="10,0" Background="#E0E0E0" LargeChange="10" SmallChange="1" Minimum="0" Maximum="100">
                        <ProgressBar.Template>
                            <ControlTemplate TargetType="ProgressBar">
                                <!-- De totale grijze achtergrondbalk -->
                                <Border 
                                Background="{TemplateBinding Background}" 
                                CornerRadius="8" SnapsToDevicePixels="True">
                                    <!-- Het hoofd-grid MOET de naam PART_Track krijgen -->
                                    <Grid x:Name="PART_Track">
                                        <!-- De gekleurde balk MOET de naam PART_Indicator krijgen -->
                                        <!-- WPF past hier nu automatisch de breedte van aan op basis van je C#-code -->
                                        <Border x:Name="PART_Indicator" 
                                        Background="#4A90E2" 
                                        CornerRadius="8" 
                                        HorizontalAlignment="Left"/>
                                    </Grid>
                                </Border>
                            </ControlTemplate>
                        </ProgressBar.Template>
                    </ProgressBar>

                    <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBox x:Name="tboxTijd" Text="TextBox" Width="60" Height="30" TextAlignment="Center" VerticalContentAlignment="Center" KeyDown="tboxTijd_KeyDown" TextChanged="tboxTijd_TextChanged" Style="{StaticResource ModernTextBox}"/>
                        <Label Content="s" VerticalAlignment="Center" Margin="5,0,0,0"/>
                    </StackPanel>
                </Grid>
            </Grid>

            <!-- 3. ONDERKANT: VOORTGANG & LOGBOEKEN -->
            <Grid Grid.Row="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="120"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="0,0,0,10">
                    <Label Content="Aantal oefeningen gemaakt:" HorizontalAlignment="Center" FontSize="12" Foreground="#666666"/>
                    <StackPanel x:Name="stackPanelVoortgang" Orientation="Horizontal" HorizontalAlignment="Center" MinHeight="25" Margin="0,5"/>
                </StackPanel>

                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Margin="0,0,10,0" Background="White" CornerRadius="10" BorderBrush="#E0E0E0" BorderThickness="1">
                        <Grid>
                            <TextBlock Text="Goed opgelost:" FontSize="11" Foreground="#137333" Margin="8,4,0,0" FontWeight="Bold" IsHitTestVisible="False" Panel.ZIndex="1"/>
                            <TextBox x:Name="tboxResultatenGoed" VerticalScrollBarVisibility="Auto" BorderThickness="0" Background="Transparent" Margin="5,20,5,5" IsReadOnly="True"/>
                        </Grid>
                    </Border>
                    <Border Grid.Column="1" Background="White" CornerRadius="10" BorderBrush="#E0E0E0" BorderThickness="1">
                        <Grid>
                            <TextBlock Text="Nog eens oefenen:" FontSize="11" Foreground="#C5221F" Margin="8,4,0,0" FontWeight="Bold" IsHitTestVisible="False" Panel.ZIndex="1"/>
                            <TextBox x:Name="tboxResultatenFout" VerticalScrollBarVisibility="Auto" BorderThickness="0" Background="Transparent" Margin="5,20,5,5" IsReadOnly="True"/>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </Grid>

        <!-- Moderne statusbalk onderaan het venster -->
        <StatusBar Grid.Row="1" Background="#EAEAEA" Padding="10,5">
            <StatusBar.ItemsPanel>
                <ItemsPanelTemplate>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                    </Grid>
                </ItemsPanelTemplate>
            </StatusBar.ItemsPanel>

            <!-- Versienummer aan de linkerkant -->
            <StatusBarItem Grid.Column="0" HorizontalAlignment="Left">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Versie:" FontFamily="Segoe UI" FontSize="12" Foreground="#666666" Margin="0,0,5,0"/>
                    <TextBlock x:Name="TxtVersie" Text="1.0.1" FontFamily="Segoe UI Semibold" FontSize="12" Foreground="#333333"/>
                </StackPanel>
            </StatusBarItem>

            <!-- About knop aan de rechterkant -->
            <StatusBarItem Grid.Column="1" HorizontalAlignment="Right">
                <Button x:Name="BtnAbout" Content="Info" Style="{StaticResource SubtleButton}" Click="BtnAbout_Click" Width="50"/>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>