<Window x:Class="Tafels.Meldingswindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Oeps!" 
        Height="220" Width="400" 
        WindowStartupLocation="CenterOwner" 
        WindowStyle="None">

    <Grid Background="#F4F7F6">
        <Border Background="White" 
                CornerRadius="15" 
                BorderBrush="#4A90E2" 
                BorderThickness="2"
                Margin="15">
            <Border.Effect>
                <DropShadowEffect BlurRadius="10" Color="#CCCCCC" Direction="270" ShadowDepth="2"/>
            </Border.Effect>

            <Grid Margin="15">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Zelfgemaakte titelbalk -->
                <TextBlock Grid.Row="0" Text="Oeps!" FontSize="18" FontFamily="Segoe UI Bold" Foreground="#4A90E2" HorizontalAlignment="Center" Margin="0,0,0,10"/>

                <!-- Tekst en Emoji -->
                <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="⚠️" FontSize="32" Margin="0,0,15,0" VerticalAlignment="Center"/>
                    <TextBlock Text="Je hebt nog geen tafel geselecteerd om te oefenen!" FontSize="14" FontFamily="Segoe UI Semibold" Foreground="#333333" VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="260"/>
                </StackPanel>

                <!-- Oké Knop -->
                <Button Grid.Row="2" Content="Oké!" Width="100" Height="35" Background="#4A90E2" Foreground="White" FontWeight="Bold" FontSize="14" HorizontalAlignment="Center" Click="OkButton_Click">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="btnBorder" Background="{TemplateBinding Background}" CornerRadius="8">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="btnBorder" Property="Background" Value="#357ABD"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>
        </Border>
    </Grid>
</Window>
